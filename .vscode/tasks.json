{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run KSU Delivery Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/ksu-delivery"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build Production Bundle",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/ksu-delivery"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Code Linter (Check Bugs)",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/ksu-delivery"
      },
      "problemMatcher": []
    }
  ]
}
